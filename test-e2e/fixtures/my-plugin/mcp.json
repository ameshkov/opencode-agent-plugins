{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "echo": {
      "type": "stdio",
      "command": "./bin/serve.js",
      "args": ["--placeholder-root", "${PLUGIN_ROOT}", "--placeholder-data", "${PLUGIN_DATA}"],
      "env": {
        "E2E_ROOT": "${PLUGIN_ROOT}",
        "E2E_DATA": "${PLUGIN_DATA}"
      }
    }
  }
}

#!/usr/bin/env node
/**
 * Bare-command (PATH-resolved) MCP stdio server for the e2e remote fixture.
 *
 * Registered in mcp.json with a bare `command: "e2e-path-tool"` (no `./`),
 * so opencode must resolve it through PATH — the behavior is delegated to
 * the host's spawn (docs/design.md §7) and pinned here.
 *
 * Dependency-free minimal MCP stdio transport (see fixtures/git-plugin's
 * serve.js for the protocol notes): initialize, ping, tools/list, tools/call.
 */

import { existsSync } from 'node:fs';

const root = process.env['PLUGIN_ROOT'] ?? '';
const data = process.env['PLUGIN_DATA'] ?? '';

/** Sends a JSON-RPC message on stdout (newline-delimited, MCP stdio). */
function send(message) {
  process.stdout.write(`${JSON.stringify(message)}\n`);
}

/** Handles one JSON-RPC message. */
function handle(message) {
  const method = message?.method;
  switch (method) {
    case 'initialize':
      send({
        jsonrpc: '2.0',
        id: message.id ?? null,
        result: {
          protocolVersion: message.params?.protocolVersion ?? '2024-11-05',
          capabilities: { tools: {} },
          serverInfo: { name: 'path-tool', version: '1.0.0' },
        },
      });
      break;
    case 'notifications/initialized':
      break;
    case 'ping':
      send({ jsonrpc: '2.0', id: message.id ?? null, result: {} });
      break;
    case 'tools/list':
      send({
        jsonrpc: '2.0',
        id: message.id ?? null,
        result: {
          tools: [
            {
              name: 'ping',
              description: `PATH-resolved ping e2e: PLUGIN_ROOT=${root}`,
              inputSchema: {
                type: 'object',
                properties: { message: { type: 'string' } },
                required: ['message'],
              },
            },
          ],
        },
      });
      break;
    case 'tools/call': {
      const args = message.params?.arguments ?? {};
      const text =
        `pong ${String(args.message ?? '')} | ` +
        `PATH_TOOL=ok; ` +
        `PLUGIN_ROOT=${root}; PLUGIN_DATA=${data}; ` +
        `CWD=${process.cwd()}; DATA_EXISTS=${existsSync(data)}`;
      send({
        jsonrpc: '2.0',
        id: message.id ?? null,
        result: { content: [{ type: 'text', text }], isError: false },
      });
      break;
    }
    default:
      send({
        jsonrpc: '2.0',
        id: message.id ?? null,
        error: { code: -32601, message: `method not found: ${method ?? '?'}` },
      });
  }
}

let buffer = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (chunk) => {
  buffer += chunk;
  let newline;
  while ((newline = buffer.indexOf('\n')) !== -1) {
    const line = buffer.slice(0, newline).trim();
    buffer = buffer.slice(newline + 1);
    if (line === '') {
      continue;
    }
    let message;
    try {
      message = JSON.parse(line);
    } catch {
      continue;
    }
    handle(message);
  }
});
process.stdin.on('end', () => {
  process.exit(0);
});
